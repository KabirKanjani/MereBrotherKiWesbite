# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# the template is committed deliberately: it documents what is needed and holds
# no real values
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# instagram harvesting: saved session cookies are credentials, never commit them
/tools/.ig-cookies.json
# the raw harvest output is regenerable, and photos are already committed under
# public/products, so keep 1.6MB of duplicates out of the history
/tools/harvest-data/photos/
/tools/harvest-data/*.bak
/tools/*.png
/tools/*.jpg

# CMS: local development database and uploaded media. Both are runtime state,
# not source. Uploads are handled by object storage in production.
/payload.db
/payload.db-journal
/media

# Generated from the collection definitions. Regenerate with `npm run generate:types`
/payload-types.ts
/generated-schema.graphql

# local dev server logs
dev.log
dev.err.log
