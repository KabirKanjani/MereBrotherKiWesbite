# Environment variables. Never commit the real values.
#
# Copy to `.env` locally, and set the same keys in your host's dashboard.
# `.env` is already in .gitignore.

# ---- Required in production -------------------------------------------------

# Signs cookies and encrypts sessions. Generate a long random value, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# If this changes, everyone is logged out. If it leaks, anyone can impersonate an
# admin account.
PAYLOAD_SECRET=

# The live address of the site, no trailing slash. Used for image URLs, canonical
# links and password reset emails.
NEXT_PUBLIC_SERVER_URL=https://kiviadesigns.in

# Postgres connection string. On Render, copy this from the Postgres instance's
# dashboard. Leaving it unset uses a local SQLite file, which is fine for
# development but will be wiped whenever the app restarts.
DATABASE_URI=

# ---- Recommended for production ---------------------------------------------

# Comma-separated origins allowed to send admin requests. Prevents another site
# riding your staff session.
CSRF_TRUST_ORIGIN=https://kiviadesigns.in

# ---- Development only -------------------------------------------------------

# Where the local SQLite file lives. Defaults to ./payload.db
# SQLITE_PATH=